# =============================================================================
#  rpi3_news2_defconfig - Monitor NEWS2, Raspberry Pi 3B+ (aarch64)
#  Base: raspberrypi3_64_defconfig (Buildroot 2025.02.18)
#  Ponto UNICO de configuracao do SO (requisito de reprodutibilidade do artigo).
# =============================================================================

# ---- [1] Arquitetura -------------------------------------------------------
BR2_aarch64=y
BR2_cortex_a53=y
BR2_ARM_FPU_VFPV4=y

# ---- [2] Build -------------------------------------------------------------
BR2_CCACHE=y
BR2_GLOBAL_PATCH_DIR="board/raspberrypi/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_OPTIMIZE_2=y

# ---- [3] Toolchain / C++ ---------------------------------------------------
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_6=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
# libstdc++: exigido por Qt e pela app
BR2_TOOLCHAIN_BUILDROOT_CXX=y
# libgomp: exigida pelo futuro porte treelite
BR2_GCC_ENABLE_OPENMP=y

# ---- [4] Base / init / BusyBox --------------------------------------------
BR2_TARGET_GENERIC_HOSTNAME="news2-monitor"
BR2_INIT_BUSYBOX=y
BR2_SYSTEM_BIN_SH_BUSYBOX=y
# devtmpfs: /dev criado pelo kernel, sem udevd -> menos boot, menos falha
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y
BR2_TARGET_ENABLE_ROOT_LOGIN=y
BR2_TARGET_GENERIC_ROOT_PASSWD="agppr"
BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW=y
BR2_TARGET_GENERIC_GETTY_PORT="ttyAMA0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
# sem BR2_SYSTEM_DHCP: o dhcpcd (S41) ja gerencia eth0 e wlan0; o udhcpc do
# ifupdown disputaria a eth0 com ele
BR2_ENABLE_LOCALE_PURGE=y
BR2_ENABLE_LOCALE_WHITELIST="C en_US pt_BR"
# Qt6 exige locale UTF-8; sem ele avisa e degrada a decodificacao de texto
BR2_GENERATE_LOCALE="C.UTF-8"
BR2_TARGET_TZ_INFO=y
BR2_TARGET_TZ_ZONELIST="southamerica etcetera"
BR2_TARGET_LOCALTIME="America/Sao_Paulo"
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
# ntpd: sem RTC o relogio nasce em 1969; S42ntpd acerta pela rede
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_NEWS2_PATH)/board/rpi3-news2/busybox.fragment"
BR2_PACKAGE_XZ=y

# ---- [5] Overlay e scripts de pos-processamento ---------------------------
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_NEWS2_PATH)/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_NEWS2_PATH)/board/rpi3-news2/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_NEWS2_PATH)/board/rpi3-news2/post-image.sh"

# ---- [6] Kernel ------------------------------------------------------------
# Kernel downstream da Raspberry Pi, no mesmo commit pinado pelo upstream
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,raspberrypi,linux,576cc10e1ed50a9eacffc7a05c796051d7343ea4)/linux-576cc10e1ed50a9eacffc7a05c796051d7343ea4.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcmrpi3"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_NEWS2_PATH)/board/rpi3-news2/linux-news2.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2710-rpi-3-b broadcom/bcm2710-rpi-3-b-plus"
# compila os .dtb com -@ (symbols); sem isso, dtoverlay= falha em silencio
BR2_LINUX_KERNEL_DTB_OVERLAY_SUPPORT=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# ---- [7] Firmware RPi ------------------------------------------------------
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_BOOTCODE_BIN=y
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_NEWS2_PATH)/board/rpi3-news2/config.txt"
BR2_PACKAGE_RPI_FIRMWARE_CMDLINE_FILE="$(BR2_EXTERNAL_NEWS2_PATH)/board/rpi3-news2/cmdline.txt"
BR2_PACKAGE_RPI_FIRMWARE_INSTALL_DTB_OVERLAYS=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_WIFI=y

# ---- [8] Grafico: Mesa VC4 + DRM/KMS --------------------------------------
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VC4=y
BR2_PACKAGE_MESA3D_GBM=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_LIBDRM_VC4=y
# modetest: valida display sem o Qt
BR2_PACKAGE_LIBDRM_INSTALL_TESTS=y
# valida EGL/GLES sem o Qt
BR2_PACKAGE_KMSCUBE=y

# ---- [9] Qt6 + QML ---------------------------------------------------------
# Qt6 e nao Qt5: o monitor-news2 exige Qt >= 6.5 (qt_add_qml_module,
# loadFromModule). O Buildroot nao permite Qt5 e Qt6 na mesma imagem.
BR2_PACKAGE_QT6=y
BR2_PACKAGE_QT6BASE=y
BR2_PACKAGE_QT6BASE_GUI=y
BR2_PACKAGE_QT6BASE_WIDGETS=y
BR2_PACKAGE_QT6BASE_OPENGL=y
# o VC4 so fala GLES
BR2_PACKAGE_QT6BASE_OPENGL_ES2=y
BR2_PACKAGE_QT6BASE_EGLFS=y
BR2_PACKAGE_QT6BASE_DEFAULT_QPA="eglfs"
BR2_PACKAGE_QT6BASE_NETWORK=y
BR2_PACKAGE_QT6BASE_XML=y
BR2_PACKAGE_QT6BASE_SQL=y
BR2_PACKAGE_QT6BASE_SQLITE=y
BR2_PACKAGE_QT6BASE_PNG=y
BR2_PACKAGE_QT6BASE_JPEG=y
BR2_PACKAGE_QT6BASE_FONTCONFIG=y
BR2_PACKAGE_QT6BASE_HARFBUZZ=y
# find_package(Qt6 ... Test) do CMakeLists do app
BR2_PACKAGE_QT6BASE_TEST=y
BR2_PACKAGE_QT6DECLARATIVE=y
BR2_PACKAGE_QT6DECLARATIVE_QUICK=y
# sem fonte, a UI sai vazia
BR2_PACKAGE_DEJAVU=y
BR2_PACKAGE_DEJAVU_SANS=y

# ---- [10] Toque capacitivo USB HID ----------------------------------------
# NAO precisa de pacote: o plugin libqevdevtouchplugin.so ja vem no qt6base e
# o Qt (sem udev) varre /dev/input/event* via QDeviceDiscoveryStatic.
# NAO habilitar libinput: exigiria eudev -> udevd no boot.
BR2_PACKAGE_EVTEST=y
# Descomente SO SE o evtest nao mostrar ABS_MT_SLOT (protocolo MT tipo A):
# BR2_PACKAGE_MTDEV=y

# ---- [11] Sensores e GPIO --------------------------------------------------
# i2cdetect: prova de bring-up do MAX30102
BR2_PACKAGE_I2C_TOOLS=y
# buzzer e LED RGB via /dev/gpiochip0
BR2_PACKAGE_LIBGPIOD=y
BR2_PACKAGE_LIBGPIOD_TOOLS=y

# ---- [12] Modulos ----------------------------------------------------------
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
BR2_PACKAGE_HOST_KMOD_XZ=y

# ---- [13] Runtime ML -------------------------------------------------------
# O modelo e TREINADO NO PC e apenas EXECUTADO aqui: basta percorrer as arvores
# do booster exportado em JSON. Nada de pip, scipy, setuptools ou xgboost.
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON_NUMPY=y

# ---- [14] Rede (conveniencia de bancada, nao requisito de runtime) ---------
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_DHCPCD=y
# sem regulatory.db o cfg80211 fica no dominio "00" e o brcmfmac recusa os
# canais 12/13 (2,4 GHz) e parte do 5 GHz: "set chanspec ... fail, reason -52"
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_IW=y

# ---- [15] Aplicacao ------------------------------------------------------
# instalada em /root/monitor-news2, sem script de init (nao sobe no boot)
BR2_PACKAGE_MONITOR_NEWS2=y
# acesso ao MAX30102 pelo driver IIO do kernel; troque por
# BR2_PACKAGE_MONITOR_NEWS2_SENSOR_I2CDEV=y para o acesso direto por i2c-dev
BR2_PACKAGE_MONITOR_NEWS2_SENSOR_IIO=y
# FC/SpO2/FR pelo PpgProcessor do app; troque por ..._PPG_HYBRID=y ou ..._PPG_PIPELINE=y
# para usar o metodo do ppg-pipeline (comparacao em software/ppg-pipeline/scripts/comparison)
BR2_PACKAGE_MONITOR_NEWS2_PPG_PROCESSOR=y

# ---- [16] Imagem -----------------------------------------------------------
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
# upstream usa 120M; o target Qt5 medido tem 122M, mais python3+numpy (~90M)
# da ~215M. 800M cobre isso com folga p/ o JSON do modelo, logs e o app futuro.
BR2_TARGET_ROOTFS_EXT2_SIZE="800M"
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y
