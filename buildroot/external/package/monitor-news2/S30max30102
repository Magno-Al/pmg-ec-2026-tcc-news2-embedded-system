#!/bin/sh
# Carrega o driver IIO do MAX30102. O device tree (overlay i2c-sensor,max30102)
# ja declara o sensor, mas sem udev/mdev nada carrega o modulo sozinho.

case "$1" in
    start)
        printf "Loading max30102: "
        modprobe max30102 && echo "OK" || echo "FAIL"
        ;;
    stop)
        printf "Unloading max30102: "
        modprobe -r max30102 && echo "OK" || echo "FAIL"
        ;;
    restart)
        "$0" stop
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
